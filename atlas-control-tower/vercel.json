{
  "version": 2,
  "builds": [
    {"src":"package.json","use":"@vercel/static-build","config":{"distDir":"dist"}},
    {"src":"api/projection.js","use":"@vercel/node"},
    {"src":"api/universal-projection.js","use":"@vercel/node"},
    {"src":"api/runner.js","use":"@vercel/node"},
    {"src":"api/science.js","use":"@vercel/node"},
    {"src":"api/observatory-questions.js","use":"@vercel/node"},
    {"src":"api/runtime-orphans.js","use":"@vercel/node"},
    {"src":"api/runtime-semantic.js","use":"@vercel/node"},
    {"src":"api/runtime-v2.js","use":"@vercel/node"},
    {"src":"api/runtime.js","use":"@vercel/node"},
    {"src":"api/auth/session.mjs","use":"@vercel/node"},
    {"src":"api/private/index.mjs","use":"@vercel/node"}
  ],
  "routes": [
    {"src":"/api/projection","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/projection.js"},
    {"src":"/api/universal-projection","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/universal-projection.js"},
    {"src":"/api/runner","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/runner.js"},
    {"src":"/api/(state|graph|entity)","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/science.js?route=$1"},
    {"src":"/api/observatory-questions","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/observatory-questions.js"},
    {"src":"/api/(state|sync|graph|entity|automation-runs|learning-relations|learning|audit|health|ops)","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/runtime-orphans.js?route=$1"},
    {"src":"/api/auth/session","dest":"/api/auth/session.mjs"},
    {"src":"/api/private/cockpit","dest":"/api/private/index.mjs?route=cockpit"},
    {"src":"/api/private/activity","dest":"/api/private/index.mjs?route=activity"},
    {"src":"/api/private/research","dest":"/api/private/index.mjs?route=research"},
    {"src":"/api/private/entity","dest":"/api/private/index.mjs?route=entity"},
    {"src":"/api/private/learner","dest":"/api/private/index.mjs?route=learner"},
    {"src":"/api/private/sync","dest":"/api/private/index.mjs?route=sync"},
    {"handle":"filesystem"},
    {"src":"/(.*)","dest":"/index.html"}
  ],
  "crons": [
    {"path":"/api/state?refresh=1","schedule":"0 8 * * *"}
  ]
}
