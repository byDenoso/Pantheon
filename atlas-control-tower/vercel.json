{
  "ignoreCommand": "prev=\"${VERCEL_GIT_PREVIOUS_SHA:-}\"; [ -n \"$prev\" ] || exit 1; git cat-file -e \"$prev^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$prev\" HEAD -- .",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "status": 307,
      "headers": {
        "Location": "https://bydenoso.github.io/Pantheon/$1",
        "X-NEXO-Authority": "TOWER_V06",
        "X-NEXO-Vercel-State": "RETIRED_COMPATIBILITY"
      }
    }
  ]
}
