{
  "version": 2,
  "builds": [
    {"src":"package.json","use":"@vercel/static-build","config":{"distDir":"dist"}},
    {"src":"api/projection.js","use":"@vercel/node"},
    {"src":"api/runner.js","use":"@vercel/node"},
    {"src":"api/runtime-orphans.js","use":"@vercel/node"},
    {"src":"api/runtime-semantic.js","use":"@vercel/node"},
    {"src":"api/runtime-v2.js","use":"@vercel/node"},
    {"src":"api/runtime.js","use":"@vercel/node"},
    {"src":"api/atlas.js","use":"@vercel/node"},
    {"src":"assets/atlas-observatory-bg.svg","use":"@vercel/static"}
  ],
  "routes": [
    {"src":"/api/projection","dest":"/api/projection.js"},
    {"src":"/api/runner","dest":"/api/runner.js"},
    {"src":"/api/(state|sync|graph|entity|automation-runs|learning-relations|learning|audit|health|ops)","dest":"/api/runtime-orphans.js?route=$1"},
    {"src":"/api/(runtime|runtime-v2|runtime-semantic|runtime-orphans|atlas)","dest":"/api/$1.js"},
    {"src":"/assets/(.*)","headers":{"Cache-Control":"public, max-age=3600, must-revalidate"}},
    {"src":"/","headers":{"Content-Type":"text/html; charset=utf-8","Cache-Control":"public, max-age=0, must-revalidate"},"dest":"/index.html"},
    {"handle":"filesystem"},
    {"src":"/.*","status":200,"headers":{"Content-Type":"text/html; charset=utf-8","Cache-Control":"public, max-age=0, must-revalidate"},"dest":"/index.html"}
  ],
  "crons": [
    {"path":"/api/state?refresh=1","schedule":"0 8 * * *"}
  ]
}
