{
  "version": 2,
  "builds": [
    {"src":"package.json","use":"@vercel/static-build","config":{"distDir":"dist"}},
    {"src":"api/projection.js","use":"@vercel/node"},
    {"src":"api/universal-projection.js","use":"@vercel/node"},
    {"src":"api/runner.js","use":"@vercel/node"},
    {"src":"api/runtime-orphans.js","use":"@vercel/node"},
    {"src":"api/runtime-semantic.js","use":"@vercel/node"},
    {"src":"api/runtime-v2.js","use":"@vercel/node"},
    {"src":"api/runtime.js","use":"@vercel/node"}
  ],
  "routes": [
    {"src":"/api/projection","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/projection.js"},
    {"src":"/api/universal-projection","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/universal-projection.js"},
    {"src":"/api/runner","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/runner.js"},
    {"src":"/api/(state|sync|graph|entity|automation-runs|learning-relations|learning|audit|provenance|health|ops|operations|universe|universe-snapshot|summary|summaries|observatory|observatory-summary|observatory-parameters|observatory-tensions|observatory-directional-signals|lab|lab-hypotheses|lab-claims|lab-tests|lab-runs|lab-results|lab-evidence|lab-pipelines)","headers":{"Access-Control-Allow-Origin":"https://bydenoso.github.io","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization","Vary":"Origin"},"dest":"/api/runtime-orphans.js?route=$1"},
    {"handle":"filesystem"},
    {"src":"/(.*)","dest":"/index.html"}
  ],
  "crons": [
    {"path":"/api/state?refresh=1","schedule":"0 8 * * *"}
  ]
}
