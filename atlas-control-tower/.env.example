# Optional API base. Use an API root that exposes /graph, /state, /entity, etc.
NEXO_API_BASE_URL=/api

# Google Identity Services client id. Public (safe in the browser bundle) -- pairs
# with GOOGLE_CLIENT_ID below on the server for audience verification.
# Without this set, the frontend shows AUTH_SETUP_REQUIRED and never fakes a session.
VITE_GOOGLE_CLIENT_ID=

# --- Server-only (api/private/*, api/auth/session.mjs, api/mcp.js). Never expose these
# with a VITE_ prefix -- they must not enter the public browser bundle. ---

# Same Google OAuth client id as above, checked as the JWT audience.
GOOGLE_CLIENT_ID=

# Comma-separated allowlist of Google account emails permitted into Cockpit/Atividade/
# Laboratório/private research. A valid, verified identity outside this list gets 403,
# not 401 -- see lib/auth.mjs classifyGoogleSession.
NEXO_ALLOWED_EMAILS=

# Comma-separated extra CORS origins allowed in addition to the production Pages
# origin (https://bydenoso.github.io, hardcoded in lib/auth.mjs), e.g. for local dev:
# NEXO_DEV_ORIGINS=http://localhost:4173,http://localhost:5173
NEXO_DEV_ORIGINS=

# Hosted scientific MCP backend writer. This token is consumed only by the Vercel
# function to create Tower mutation-inbox commits and one-request dispatch commits.
# Never send it as an MCP tool argument and never expose it to the browser.
NEXO_TOWER_GITHUB_TOKEN=

# Optional dedicated SHA-256 of the MCP bearer key. When absent the endpoint reuses
# the existing runner-key hash contract, so credentials still remain outside source.
NEXO_MCP_ACCESS_KEY_SHA256=

# Optional JSON registry for additional frozen science capabilities. The hosted
# gateway still rejects tasks outside its allowlist; this is not arbitrary shell.
NEXO_SCIENCE_CAPABILITIES_JSON=
