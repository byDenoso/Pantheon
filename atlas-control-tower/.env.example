# Optional API base. Use an API root that exposes /graph, /state, /entity, etc.
NEXO_API_BASE_URL=/api

# Google Identity Services client id. Public (safe in the browser bundle) -- pairs
# with GOOGLE_CLIENT_ID below on the server for audience verification.
# Without this set, the frontend shows AUTH_SETUP_REQUIRED and never fakes a session.
VITE_GOOGLE_CLIENT_ID=

# --- Server-only (api/private/*, api/auth/session.mjs). Never expose these with a
# VITE_ prefix -- they must not enter the public browser bundle. ---

# Same Google OAuth client id as above, checked as the JWT audience.
GOOGLE_CLIENT_ID=

# Comma-separated allowlist of Google account emails permitted into Cockpit/Atividade/
# Laboratório/private research. A valid, verified identity outside this list gets 403,
# not 401 -- see lib/auth.mjs classifyGoogleSession.
NEXO_ALLOWED_EMAILS=

# Comma-separated extra CORS origins allowed in addition to the production Pages
# origin (https://bydenoso.github.io, hardcoded in lib/auth.mjs), e.g. for local dev:
# NEXO_DEV_ORIGINS=http://localhost:4173,http://localhost:5173
NEXO_DEV_ORIGINS=
