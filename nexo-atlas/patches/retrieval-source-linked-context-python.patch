+def test_unresolved_fields_deduplicate_across_roots_without_target_leaks(tmp_path, source):
+    source["entities/artifact/DATA-SN.json"].pop("dataset")
+    source["entities/test/TEST-H0-005.json"]["refs"] = ["GHOST-MISSING", "SECRET-COMET"]
+    source["entities/test/TEST-SECOND.json"] = {"id": "TEST-SECOND", "kind": "TEST", "state": "ACTIVE"}
+    source["evolution/board.json"] = {"posts": [{"id": "BP-SHARED", "refs": ["TEST-H0-005", "TEST-SECOND", "GHOST-BOARD"]}]}
+    snapshot = save(tmp_path / "tower.json", source)
+    engine = Retrieval(tmp_path / "unresolved.sqlite3")
+    engine.sync(snapshot)
+    result = engine.search("TEST-H0-005 TEST-SECOND evidence", "LEARNER", k=50)
+    summary = result["graph_summary"]
+    assert summary["unresolved_source_field_count"] == 2
+    assert summary["context_completeness"] == "BOUNDED_OR_UNRESOLVED"
+    assert summary["exhaustive_review_context"] is False
+    assert summary["computed_witness_complete"] and summary["witness_complete"]
+    assert "SECRET-COMET" not in json.dumps(result)
+    assert "GHOST-MISSING" not in json.dumps(summary) and "GHOST-BOARD" not in json.dumps(summary)
+
