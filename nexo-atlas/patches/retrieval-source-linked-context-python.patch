@@ -0,0 +1,278 @@
+"""Bounded source-linked context is a retrieval policy, not scientific support."""
+from __future__ import annotations
+
+import json
+import pytest
+
+from conftest import save
+from runtime.nexo_agent_api.memory import SourceError
+from runtime.nexo_agent_api.retrieval import Retrieval, resolve_pointer
+
+
+@pytest.mark.parametrize("cue", [
+    "correção", "correções", "corrige", "corrigem", "corrigir", "correction", "corrections", "corrected",
+    "revisão", "revisões", "review", "reviews", "reviewed", "interpretação", "interpretações",
+    "interpretation", "interpretations", "interpretar", "interpret", "evidência", "evidências", "evidence",
+])
+def test_folded_context_cues_are_whole_words(cue):
+    route = Retrieval.route(f"[entity] {cue}", True, {})
+    assert route == {"mode": "graph", "reason": "identifier_with_source_linked_context_request",
+                     "target_kinds": [], "strategy": "bounded_source_linked_context"}
+    assert Retrieval.route(cue, False, {})["mode"] == "lexical"
+
+
+@pytest.mark.parametrize("word", ["preview", "reviewer", "uncorrected", "correctional", "evidential", "interpretative",
+                                  "correlacao", "correlacoes", "evidence_extra"])
+def test_context_and_portuguese_relation_cues_do_not_match_substrings(word):
+    assert Retrieval.route(f"[entity] {word}", True, {})["mode"] == "exact"
+
+
+@pytest.mark.parametrize("cue", ["relação", "relações"])
+def test_portuguese_relation_uses_existing_structural_strategy(cue):
+    assert Retrieval.route(f"[entity] {cue}", True, {})["strategy"] == "bounded_explicit_graph"
+
+
+@pytest.mark.parametrize("field", ["notes", "question", "payload.interpretation"])
+def test_literal_field_guard_precedes_context_cues(field):
+    route = Retrieval.route(f"{field}: [entity] correção review evidence", True, {})
+    assert route == {"mode": "lexical", "reason": "literal_field_passage_with_incidental_references"}
+
+
+@pytest.mark.parametrize("query", ["Evidence chain for [entity]", "Cadeia de evidências de [entity]",
+                                  "Trace the evidence for [entity]", "Evidence connecting [entity]"])
+def test_explicit_graph_request_precedes_evidence_only_cue(query):
+    assert Retrieval.route(query, True, {})["strategy"] == "bounded_explicit_graph"
+
+
+@pytest.mark.parametrize("query", ["Trace correction for [entity]", "Tracing review of [entity]",
+    "Review the chain for [entity]", "Correction of chains from [entity]", "Revisão da cadeia de [entity]",
+    "Corrigir cadeias de [entity]", "Connect correction for [entity]", "Review connects [entity]",
+    "Connecting reviewed [entity]", "Connected correction [entity]", "Revisão conecta [entity]",
+    "Correções conectam [entity]", "Conectar interpretação de [entity]", "Conectando correção de [entity]"])
+def test_mixed_traversal_and_context_cues_preserve_structural_witness(query):
+    assert Retrieval.route(query, True, {})["strategy"] == "bounded_explicit_graph"
+
+
+@pytest.mark.parametrize("query", [
+    "Review the connection between HYP-H0 and RECIPE-GLS",
+    "Which review traces HYP-H0 to RECIPE-GLS?",
+    "Revisão da conexão de HYP-H0 com RECIPE-GLS",
+])
+def test_mixed_connection_inflections_return_actual_two_hop_witness(indexed, query):
+    result = indexed[0].search(query, "LEARNER")
+    assert result["route"]["strategy"] == "bounded_explicit_graph"
+    target = next(h for h in result["hits"] if h["id"] == "RECIPE::RECIPE-GLS")
+    assert target["graph_path"]["seed"] == "HYPOTHESIS::HYP-H0"
+    assert target["graph_path"]["distance"] == 2
+    assert len(target["graph_path"]["edges"]) == 2
+
+
+@pytest.mark.parametrize("word", ["independent", "independently", "independence", "independente",
+                                  "independentes", "independência"])
+def test_independence_words_are_not_dependency_requests_in_evidence_queries(word):
+    assert Retrieval.route(f"[entity] {word} evidence", True, {})["strategy"] == "bounded_source_linked_context"
+    assert Retrieval.route(f"[entity] {word}", True, {})["strategy"] == "bounded_explicit_graph"
+
+
+@pytest.fixture
+def linked(tmp_path, source):
+    # The base fixture's dataset label is an unresolved source assertion; keep
+    # this fully resolved fixture separate from the dedicated unresolved case.
+    source["entities/artifact/DATA-SN.json"].pop("dataset")
+    source["evolution/board.json"] = {"posts": [
+        {"id": "BP-Z-CORRECTION", "title": "correction of QSO rejection by Planck prior",
+         "refs": ["TEST-H0-005", "TEST-REVIEW-ID"], "related_ids": ["TEST-H0-005"],
+         "notes": "QSO alone is not independent; Planck prior changes interpretation", "state": "OPEN"},
+        {"id": "BP-A-LINK", "title": "Archive comment", "refs": ["TEST-H0-005"], "state": "OPEN"},
+        {"id": "BP-NO-LINK", "title": "correction of QSO rejection by Planck prior", "state": "OPEN"},
+        {"id": "BP-RESTRICTED", "title": "correction", "refs": ["TEST-H0-005"], "allowed_roles": ["ENGINEER"]},
+    ]}
+    source["entities/test/TEST-REVIEW-ID.json"] = {"id": "TEST-REVIEW-ID", "kind": "TEST", "state": "ACTIVE",
+                                                "refs": ["TEST-H0-005"]}
+    snapshot = save(tmp_path / "tower.json", source)
+    engine = Retrieval(tmp_path / "linked.sqlite3")
+    engine.sync(snapshot)
+    return engine, snapshot
+
+
+def assert_no_models(monkeypatch, engine):
+    def fail(*args, **kwargs):
+        raise AssertionError("source-linked retrieval must not call a model")
+    monkeypatch.setattr(engine, "_lsa", fail)
+    monkeypatch.setattr(engine, "_embedding_scores", fail)
+    engine.embedding = engine.reranker = object()
+
+
+def test_direct_authorized_edges_only_lexically_ranked(linked, monkeypatch):
+    engine, snapshot = linked
+    assert_no_models(monkeypatch, engine)
+    query = "TEST-H0-005 correction QSO rejection Planck prior"
+    result = engine.search(query, "LEARNER", k=50, as_of=snapshot.observed_at)
+    hits = result["hits"]
+    assert hits[0]["id"] == "TEST::TEST-H0-005"
+    assert hits[1]["id"] == "BOARD_POST::BP-Z-CORRECTION"
+    ids = {h["id"] for h in hits}
+    assert "BOARD_POST::BP-A-LINK" in ids
+    assert "BOARD_POST::BP-NO-LINK" not in ids  # lexical similarity cannot supply candidates
+    assert "RESULT::RESULT-H0" not in ids  # two-hop evidence is outside this policy
+    assert "BP-RESTRICTED" not in json.dumps(result)
+    assert result["models"] == {} and result["model_sha256"] is None
+    assert result["search_policy"] == "reviewed-source-linked-context-v1"
+    assert result["method"] == "nexo-retrieval-1.3.0"
+    assert result["graph_summary"]["scientific_independence"] == "NOT_ESTABLISHED"
+    assert result["graph_summary"]["generated_edges"] == 0
+    assert result["graph_summary"]["witness_complete"]
+    assert result["graph_summary"]["context_scope"] == "direct_authorized_source_assertions_only"
+    assert result["graph_summary"]["context_completeness"] == "RESOLVED_DIRECT_AUTHORIZED_LINKS"
+    assert result["graph_summary"]["unresolved_source_field_count"] == 0
+    assert result["graph_summary"]["exhaustive_review_context"] is False
+    assert [h["id"] for h in hits[1:]] == [h["id"] for h in sorted(
+        hits[1:], key=lambda h: (-(h["stage_scores"]["rrf"] or 0), h["id"]))]
+    view = engine._view("LEARNER", as_of=snapshot.observed_at)
+    for rank, hit in enumerate(hits, 1):
+        path = hit["graph_path"]
+        assert hit["score"] == 1 / rank and path["structural_rank"] == rank
+        assert path["distance"] == (0 if rank == 1 else 1)
+        assert path["provenance"] == "explicit_canonical_fields_only"
+        assert len(path["edges"]) == (0 if rank == 1 else 1)
+        for edge in path["edges"]:
+            source = view["documents"][edge["source"]]
+            reference = resolve_pointer(source.data, edge["pointer"][len(source.pointer):])
+            assert edge["target"] in view["aliases"][reference]
+            assert edge["citation"]["json_pointer"] == edge["pointer"]
+            assert edge["citation"]["content_sha256"] == source.content_hash
+
+
+def test_result_filters_do_not_discard_root_or_trigger_lsa(linked, monkeypatch):
+    engine, snapshot = linked
+    assert_no_models(monkeypatch, engine)
+    result = engine.search("TEST-H0-005 interpretation Planck prior", "LEARNER",
+                           filters={"kind": "BOARD_POST"}, as_of=snapshot.observed_at)
+    assert [h["id"] for h in result["hits"]] == ["BOARD_POST::BP-Z-CORRECTION", "BOARD_POST::BP-A-LINK"]
+    assert all(h["graph_path"]["seed"] == "TEST::TEST-H0-005" for h in result["hits"])
+    assert result["models"] == {}
+
+
+@pytest.mark.parametrize("query", ["TEST-REVIEW-ID", "Qual é a versão atual de TEST-REVIEW-ID?",
+                                  "What is the current version of TEST-REVIEW-ID?"])
+def test_raw_id_and_current_version_remain_exact(linked, query):
+    result = linked[0].search(query, "LEARNER")
+    assert result["mode"] == "exact"
+    assert [h["id"] for h in result["hits"]] == ["TEST::TEST-REVIEW-ID"]
+    assert result["graph_summary"] is None
+
+
+def test_explicit_graph_mode_keeps_legacy_behavior(linked):
+    result = linked[0].search("TEST-H0-005 correction", "LEARNER", mode="graph", k=50)
+    assert result["mode"] == "graph" and result["graph_summary"] is None
+    assert "RESULT::RESULT-H0" in {h["id"] for h in result["hits"]}
+    assert any(h["graph_path"] and h["graph_path"]["distance"] == 2 for h in result["hits"])
+
+
+def test_two_roots_sorted_with_deterministic_edge_witness(linked):
+    engine, snapshot = linked
+    view = engine._view("LEARNER", as_of=snapshot.observed_at)
+    roots = ["TEST::TEST-H0-005", "TEST::TEST-REVIEW-ID"]
+    query = "TEST-REVIEW-ID TEST-H0-005 evidence"
+    result = engine.search(query, "LEARNER", k=50, as_of=snapshot.observed_at)
+    assert [h["id"] for h in result["hits"][:2]] == sorted(roots)
+    assert [h["graph_path"]["seed"] for h in result["hits"][:2]] == sorted(roots)
+    scores, paths, summary = engine._source_linked_candidates(view, roots[::-1], set(view["documents"]), {})
+    scores2, paths2, summary2 = engine._source_linked_candidates(view, roots, set(view["documents"]), {})
+    assert (scores, paths, summary) == (scores2, paths2, summary2)
+    witness = paths["BOARD_POST::BP-Z-CORRECTION"]
+    assert witness["seed"] == roots[0]
+    matching_edges = [edge for edge in engine._walk(view, roots[0], depth=1, direction="both", relation=None, limit=200)["edges"]
+                      if {edge["source"], edge["target"]} == {roots[0], "BOARD_POST::BP-Z-CORRECTION"}]
+    assert witness["edges"] == [min(matching_edges, key=lambda e: (e["source"], e["target"], e["relation"], e["pointer"]))]
+    expected_visited = set()
+    for root in roots:
+        expected_visited.update(n["id"] for n in engine._walk(view, root, depth=1, direction="both", relation=None, limit=200)["nodes"])
+    assert summary["visited_authorized_nodes"] == len(expected_visited)
+
+
+def test_more_than_two_roots_fail_closed(linked):
+    with pytest.raises(SourceError, match="GRAPH_QUERY_REQUIRES_AT_MOST_TWO_ENTITIES"):
+        linked[0].search("TEST-H0-005 TEST-REVIEW-ID HYP-H0 evidence", "LEARNER")
+
+
+@pytest.mark.parametrize("budget", [400, 800, 2000, 8000])
+def test_context_budget_and_citations_remain_honest(linked, monkeypatch, budget):
+    engine, snapshot = linked
+    assert_no_models(monkeypatch, engine)
+    result = engine.context("TEST-H0-005 correction QSO Planck prior", "LEARNER", budget_chars=budget,
+                            as_of=snapshot.observed_at)
+    assert len(result["context"]) == result["context_chars"] <= budget
+    assert result["included_hit_count"] == len(result["hits"]) <= result["retrieved_hit_count"]
+    summary = result["graph_summary"]
+    assert summary["returned_count"] == result["included_hit_count"]
+    assert summary["results_truncated"] == (summary["candidate_count"] > len(result["hits"]))
+    if summary["results_truncated"]:
+        assert summary["truncated"] and not summary["witness_complete"]
+        assert summary["context_completeness"] == "BOUNDED_OR_UNRESOLVED"
+    if not result["hits"]:
+        assert result["answer_status"] == "CONTEXT_BUDGET_INSUFFICIENT"
+    for hit in result["hits"]:
+        ref = hit["citation"]
+        assert ref["path"] + ref["json_pointer"] in result["context"]
+
