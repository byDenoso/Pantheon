+    assert summary["visited_authorized_nodes"] == 200
+    assert summary["traversal_truncated"] and summary["results_truncated"] and summary["truncated"]
+    assert not summary["computed_witness_complete"] and not summary["witness_complete"]
+    assert len(result["hits"]) == 50
