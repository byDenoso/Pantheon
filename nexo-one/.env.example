# All credentials are server-only. No VITE_ secrets.
# Private personal access uses a server-side scrypt password hash and HttpOnly signed session cookie.
NEXO_PASSWORD_HASH=
NEXO_SESSION_SECRET=

# Preferred Google runtime: Vercel Connect supplies operation-scoped tokens via VERCEL_OIDC_TOKEN.
GOOGLE_CONNECTOR=
# Legacy OAuth remains supported. Reauthorize after enabling PERSONAL_LOOP_V1 write scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_FOLDER_ID=

# Canonical NEXO Sheet used for task/commitment state plus execution/effect receipts.
NEXO_SHEET_ID=
NEXO_SHEET_RANGE=NEXO!A1:H1000
NEXO_ACTION_REGISTER_ID=

# Canonical Drive SSOT used by Atlas/research surfaces when configured.
DRIVE_SSOT_SPREADSHEET_ID=

GITHUB_REPOSITORY=byDenoso/Pantheon
GITHUB_TOKEN=
VERCEL_READ_TOKEN=
VERCEL_TEAM_ID=team_TLkDXqQIHke6IumXh3qzMDcs
VERCEL_PROJECT_ID=

# Existing fallback NEXO export: {version,revision,items: CockpitItem[]}.
NEXO_SOURCE_URL=
NEXO_SOURCE_TOKEN=
# Optional existing Graph Contract V1 endpoint; configure only with authorized service access.
ATLAS_GRAPH_URL=
ATLAS_SOURCE_TOKEN=
