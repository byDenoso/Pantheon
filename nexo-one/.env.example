# All credentials are server-only. No VITE_ secrets. No database required.
# Single-user access: password hash is scrypt$<hex salt>$<hex derived key>.
# Generate with: node scripts/password.mjs (reads password from stdin).
NEXO_PASSWORD_HASH=
NEXO_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Restrict Drive to an existing folder when desired.
GOOGLE_DRIVE_FOLDER_ID=
GITHUB_REPOSITORY=byDenoso/Pantheon
GITHUB_TOKEN=
VERCEL_READ_TOKEN=
VERCEL_TEAM_ID=team_TLkDXqQIHke6IumXh3qzMDcs
VERCEL_PROJECT_ID=
# Existing canonical NEXO export: {version,revision,items: CockpitItem[]}.
NEXO_SOURCE_URL=
NEXO_SOURCE_TOKEN=
# Optional existing Graph Contract V1 endpoint; configure only with authorized viewer access.
ATLAS_GRAPH_URL=
ATLAS_SOURCE_TOKEN=
