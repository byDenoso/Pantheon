# All credentials are server-only. No VITE_ secrets. No database required.
# Single-user access: password hash is scrypt$<hex salt>$<hex derived key>.
# Generate with: node scripts/password.mjs (reads password from stdin).
NEXO_PASSWORD_HASH=
NEXO_SESSION_SECRET=

# Preferred Google path: existing Vercel Connect connector + user subject.
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime when OIDC is enabled.
GOOGLE_CONNECTOR=
GOOGLE_CONNECT_SUBJECT_ID=owner

# Legacy Google OAuth fallback. Keep server-only; write scopes are requested per action.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Restrict Drive to an existing folder when desired.
GOOGLE_DRIVE_FOLDER_ID=

# Canonical NEXO SSoT and existing ACTION_REGISTER.
NEXO_SHEET_ID=1e6s2dKOYVLNsPUguHI85RLVLwJKtlCsQZBJ1BE-UhaY
NEXO_SHEET_RANGE=NEXO!A1:H1000
NEXO_ACTION_REGISTER_ID=1twRpSoZCOXv77YyCh_5V9nAS2PM2nqzex2A37eI2Zas
# Optional versioned canonical export fallback when direct Sheets access is not configured.
NEXO_SOURCE_URL=
NEXO_SOURCE_TOKEN=

# GitHub actions are pinned to this existing repository.
GITHUB_REPOSITORY=byDenoso/Pantheon
GITHUB_TOKEN=

# Vercel actions are pinned to the existing NEXO ONE project/team.
VERCEL_READ_TOKEN=
VERCEL_WRITE_TOKEN=
VERCEL_TEAM_ID=team_TLkDXqQIHke6IumXh3qzMDcs
VERCEL_PROJECT_ID=prj_rFoAEgGt4gFNr8DHEOzxY7keS16W

# Optional existing Graph Contract V1 endpoint; Atlas remains derived/non-authoritative.
ATLAS_GRAPH_URL=
ATLAS_SOURCE_TOKEN=
