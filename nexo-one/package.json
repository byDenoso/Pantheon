{
  "name": "nexo-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "build": "vite build",
    "preview": "node scripts/dev.mjs --built",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
