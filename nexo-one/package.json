{
  "name": "nexo-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "google-auth": "node scripts/google-auth.mjs",
    "typecheck": "tsc --noEmit",
