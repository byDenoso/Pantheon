{
  "buildCommand":"npm run build", "outputDirectory":"dist", "framework":"vite",
  "functions":{"api/index.js":{"maxDuration":30}},
  "rewrites":[
    {"source":"/api/atlas/graph","destination":"/api/index?route=atlas-graph"},
    {"source":"/api/observatory/:view","destination":"/api/index?route=observatory-:view"},
    {"source":"/api/lab/:view","destination":"/api/index?route=lab-:view"},
    {"source":"/api/universe/snapshot","destination":"/api/index?route=universe-snapshot"},
    {"source":"/api/:route","destination":"/api/index?route=:route"}
  ],
  "headers":[{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
  ]}]
}
