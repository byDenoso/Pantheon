{
  "ignoreCommand": "prev=\"${VERCEL_GIT_PREVIOUS_SHA:-}\"; [ -n \"$prev\" ] || exit 1; git cat-file -e \"$prev^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$prev\" HEAD -- nexo-one vercel.json ':(exclude)nexo-one/tower-head.json' ':(exclude)nexo-one/tcc-public-inbox-ack.json'",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd nexo-one && npm ci --no-audit --no-fund --ignore-scripts",
  "buildCommand": "cd nexo-one && npm run build",
  "outputDirectory": "nexo-one/dist",
  "rewrites": [
    {
      "source": "/api/atlas-private-assets/:asset*",
      "destination": "/api/index?route=atlas-private-asset&asset=:asset*"
    },
    {
      "source": "/api/:route",
      "destination": "/api/index?route=:route"
    },
    {
      "source": "/api/:route/:subroute",
      "destination": "/api/index?route=:route/:subroute"
    },
    {
      "source": "/cockpit",
      "destination": "/cockpit.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "nexo-one/server/private-ui/**"
    }
  },
  "headers": [
    {
      "source": "/cockpit",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/cockpit.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
