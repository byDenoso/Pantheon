{
  "ignoreCommand": "prev=\"${VERCEL_GIT_PREVIOUS_SHA:-}\"; [ -n \"$prev\" ] || exit 1; git cat-file -e \"$prev^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$prev\" HEAD -- nexo-one vercel.json",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd nexo-one && npm ci --no-audit --no-fund --ignore-scripts",
  "buildCommand": "cd nexo-one && npm run build",
  "outputDirectory": "nexo-one/dist",
  "rewrites": [
    {
      "source": "/api/nexo-writer",
      "destination": "/api/nexo-writer.py"
    },
    {
      "source": "/api/:route",
      "destination": "/api/index?route=:route"
    },
    {
      "source": "/api/:route/:subroute",
      "destination": "/api/index?route=:route/:subroute"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/nexo-writer.py": {
      "maxDuration": 300
    }
  }
}
